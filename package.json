{
  "name": "factorio-command-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "index": "node scripts/index-library.mjs",
    "sync-game": "node scripts/sync-game.mjs",
    "index:production": "node scripts/index-production.mjs",
    "index:blueprints": "node scripts/import-autosaved.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:game": "node tests/game.mjs",
    "generate:mall": "node scripts/generate-roboport-mall.mjs",
    "test:mall": "node tests/roboport-mall.mjs",
    "generate:belt-mall": "node scripts/generate-belt-tesla-mall.mjs",
    "test:belt-mall": "node tests/belt-tesla-mall.mjs",
    "generate:robot-mall": "node scripts/generate-robot-expansion-mall.mjs",
    "test:robot-mall": "node tests/robot-expansion-mall.mjs",
    "package:mod": "python3 scripts/package-mod.py",
    "install:mod": "python3 scripts/package-mod.py --install",
    "test:fusion": "node tests/fusion-reactor.mjs",
    "test:fusion-browser": "node tests/fusion-website.mjs",
    "index:atlas": "node scripts/index-atlas.mjs",
    "generate:cells": "node scripts/generate-recipe-cells.mjs",
    "test:cells": "node tests/recipe-cells.mjs",
    "test:atlas-browser": "node tests/atlas-browser.mjs",
    "serve": "node scripts/serve.mjs",
    "test:watchdog": "python3 tests/watchdog.test.py",
    "healthcheck": "node ops/healthcheck.mjs",
    "serve:analytics": "node analytics/server.mjs",
    "test:analytics-browser": "node tests/analytics-browser.mjs",
    "prepare:early-game": "node scripts/prepare-early-game.mjs",
    "test:early-game": "node tests/early-game.mjs",
    "test:early-game-browser": "node tests/early-game-browser.mjs",
    "prepare:transport": "node scripts/prepare-transport-workshops.mjs",
    "test:transport": "STARTER_SOURCE_ROOT=blueprint-sources/transport-workshops STARTER_TEST_ROOT=.cache/transport-workshops/native node tests/early-game.mjs",
    "test:transport-browser": "node tests/transport-workshops-browser.mjs",
    "test:blueprint-updates-browser": "node tests/blueprint-updates-browser.mjs",
    "benchmark:transport": "STARTER_BENCHMARK=1 STARTER_SOURCE_ROOT=blueprint-sources/transport-workshops STARTER_TEST_ROOT=.cache/transport-workshops/throughput node tests/early-game.mjs",
    "publish:transport": "node scripts/publish-transport-workshops.mjs",
    "benchmark:early-game": "STARTER_BENCHMARK=1 STARTER_WORKERS=4 STARTER_TEST_ROOT=.cache/early-game/throughput node tests/early-game.mjs",
    "test:science": "STARTER_SOURCE_ROOT=blueprint-sources/science-factories node tests/science-factory.mjs",
    "benchmark:science": "STARTER_BENCHMARK=1 STARTER_SOURCE_ROOT=blueprint-sources/science-factories STARTER_TEST_ROOT=.cache/science-factory/throughput node tests/science-factory.mjs",
    "publish:science": "node scripts/index-science-factories.mjs",
    "test:rates-browser": "node tests/blueprint-rates-browser.mjs",
    "test:versions-browser": "node tests/blueprint-versions-browser.mjs",
    "prepare:power": "node scripts/generate-power-workshops.mjs",
    "test:power": "STARTER_SOURCE_ROOT=blueprint-sources/power-workshops STARTER_TEST_ROOT=.cache/power-workshops/native SIMULATED_MINUTES=30 node tests/power-workshops.mjs",
    "benchmark:power": "STARTER_BENCHMARK=1 STARTER_SOURCE_ROOT=blueprint-sources/power-workshops STARTER_TEST_ROOT=.cache/power-workshops/throughput SIMULATED_MINUTES=45 node tests/power-workshops.mjs"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "sharp": "^0.35.4"
  }
}
